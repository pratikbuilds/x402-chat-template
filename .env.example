ANTHROPIC_API_KEY=sk-xxx
EXPO_UNSTABLE_DEPLOY_SERVER=1
CLOUDFLARE_ACCOUNT_ID=...
EXPO_PUBLIC_CLOUDFLARE_AGENT_HOST=http://127.0.0.1:8787
EXPO_PUBLIC_MOCK_AI=0
CLOUDFLARE_DEV_INSTANCE=local-chat

# Copy ANTHROPIC_API_KEY into worker/.dev.vars for reliable local chat responses.
# Without it, the Worker falls back to Cloudflare Workers AI (@cf/zai-org/glm-4.7-flash).
